<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlap face: the hour and the minutes as two heavy rows that run into each other.

  A plain vertical LinearLayout, where the updater gives the minutes a NEGATIVE top margin
  so the rows genuinely interlock rather than merely touch. RemoteViews cannot set a
  margin from XML at runtime, but setViewLayoutMargin (API 31+) can, and it applies the
  value straight to topMargin without clamping, so a negative pulls the row up. The
  minutes come second in the file, so they draw over the hour. Each row also carries a
  shadow in the widget's own surface colour, which haloes the digits so an overlapped one
  is cut away from the one on top: that is what lets every digit share a colour and still
  be read, as on the watch face this is modelled on. setShadowLayer is not remotable, so
  it has to be declared here rather than set per update.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview" />

    <LinearLayout
        android:id="@+id/widget_text_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

            <TextClock
                android:id="@+id/overlap_hour_modern_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_hour_modern_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-black"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size" />
            <TextClock
                android:id="@+id/overlap_hour_classic_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="serif"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_hour_classic_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/overlap_minute_modern_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_minute_modern_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-black"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size" />
            <TextClock
                android:id="@+id/overlap_minute_classic_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="serif"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_minute_classic_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:shadowColor="@color/widget_surface"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
