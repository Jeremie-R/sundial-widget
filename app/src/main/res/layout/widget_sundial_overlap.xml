<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlap face: the hour and the minutes as two heavy rows that run into each other.

  Both rows sit centred in the same FrameLayout, so they start on top of one another;
  the updater then pushes them apart with padding, which is remotable where a negative
  margin would not be. Padding on a centred wrap_content view shifts its text by half the
  padding, so the hour is nudged up and out one way and the minutes the other. The minutes
  come second in the file, so they draw over the hour.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview" />

    <FrameLayout
        android:id="@+id/widget_text_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

            <TextClock
                android:id="@+id/overlap_hour_modern_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_hour_modern_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size" />
            <TextClock
                android:id="@+id/overlap_hour_classic_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_hour_classic_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/overlap_minute_modern_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_minute_modern_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size" />
            <TextClock
                android:id="@+id/overlap_minute_classic_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
            <TextClock
                android:id="@+id/overlap_minute_classic_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_time_text_size"
                android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
