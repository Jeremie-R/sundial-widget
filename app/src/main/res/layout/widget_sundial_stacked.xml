<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacked face: the hour over the minutes as one two-line TextClock, so lineSpacingMultiplier closes the gap between the rows and the four digits read as one block.

  The time is a TextClock so the launcher ticks it for us. A RemoteViews client cannot
  set a typeface at runtime, so every family/weight is a view here and the updater shows
  one and hides the rest. Size, colour, stretch and tracking ARE remotable and are set
  per widget size.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview" />

    <LinearLayout
        android:id="@+id/widget_text_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/stack_modern_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:format12Hour="h\nmm"
            android:format24Hour="HH\nmm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.76"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_time_text_size"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/stack_modern_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:format12Hour="h\nmm"
            android:format24Hour="HH\nmm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.76"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_time_text_size" />
        <TextClock
            android:id="@+id/stack_classic_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:format12Hour="h\nmm"
            android:format24Hour="HH\nmm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.76"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_time_text_size"
            android:visibility="gone" />
        <TextClock
            android:id="@+id/stack_classic_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:format12Hour="h\nmm"
            android:format24Hour="HH\nmm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.76"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_time_text_size"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
